# Пример настроек. Скопируй в .env, подставь значения и запускай так:
#
#   node --env-file=.env server.js
#
# Флаг --env-file умеет сам Node 20.6+, зависимости не нужны.
# Файл .env в .gitignore и в репозиторий не попадает.
#
# Обычный запуск без .env тоже работает: включится мок-режим.

# Порт сервера
PORT=3000

# Публичный адрес. В него ЮKassa возвращает клиента после оплаты.
# На хостинге должен быть https://ваш-домен
PUBLIC_URL=http://localhost:3000

# Режим оплаты: mock (фейковый провайдер, по умолчанию) или live
PAY_MODE=mock

# Ключи ЮKassa. Нужны только для PAY_MODE=live.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
